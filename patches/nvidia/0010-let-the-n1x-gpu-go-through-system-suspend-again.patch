From 877f86695a120cf32dfee351a0533a8bea63e0f0 Mon Sep 17 00:00:00 2001
From: Brandon Sneed <brandon@redf.net>
Date: Sat, 21 Nov 2026 13:25:52 -0800
Subject: [PATCH] nvidia: let the N1x GPU (RTX Spark N1X) go through system
 suspend again

620.73.04 adds GB20B and GB20C to the chips whose power management is
unsupported (gpuIsPowerManagementUnsupported(), which replaced the
PDB_PROP_GPU_POWER_MANAGEMENT_UNSUPPORTED property of 615.78.08). That
sets nv->is_pm_unsupported, and nv_suspend_devices() then refuses every
system suspend with NV_ERR_NOT_SUPPORTED: on an N1x laptop the kernel
logs "NVRM: PM suspend notifier failed: 0x56" and s2idle aborts at
once, from logind and from /sys/power/state alike.

GB20B is also the integrated GPU of the N1x laptops (RTX Spark N1X,
PCI device IDs 2E03/2E06/2E13), which suspend and resume with 615.
Leave those three devices out of the check, so they go through suspend
as they did up to 615. Every other chip on the list keeps 620's
behaviour, GB20C and the other GB20B parts included: GB10 (DGX Spark,
2E12) may well be what NVIDIA listed GB20B for.
---
 .../arch/nvalloc/unix/src/dynamic-power.c     | 30 ++++++++++++++++++-
 1 file changed, 29 insertions(+), 1 deletion(-)

diff --git a/src/nvidia/arch/nvalloc/unix/src/dynamic-power.c b/src/nvidia/arch/nvalloc/unix/src/dynamic-power.c
index b993b01..d11dfe9 100644
--- a/src/nvidia/arch/nvalloc/unix/src/dynamic-power.c
+++ b/src/nvidia/arch/nvalloc/unix/src/dynamic-power.c
@@ -3176,6 +3176,28 @@ static NvBool RmConfigureUpstreamPortForRTD3(
     return NV_TRUE;
 }
 
+//
+// The N1x laptops' integrated GPU, RTX Spark N1X (GB20B, PCI device IDs
+// 2E03, 2E06 and 2E13).
+//
+static NvBool RmIsN1xLaptopGpu(
+    nv_state_t *nv
+)
+{
+    if (nv->pci_info.vendor_id != 0x10DE)
+        return NV_FALSE;
+
+    switch (nv->pci_info.device_id)
+    {
+        case 0x2E03:
+        case 0x2E06:
+        case 0x2E13:
+            return NV_TRUE;
+        default:
+            return NV_FALSE;
+    }
+}
+
 void RmInitPowerManagement(
     nv_state_t *nv
 )
@@ -3198,7 +3220,13 @@ void RmInitPowerManagement(
             nvp->gc6_upstream_port_configured = RmConfigureUpstreamPortForRTD3(nv, NV_TRUE);
         }
 
-        nv->is_pm_unsupported = gpuIsPowerManagementUnsupported(pGpu);
+        //
+        // The N1x laptops go through system suspend (s2idle) as they did up
+        // to 615. Every other GB20B part, GB10 (DGX Spark) among them, keeps
+        // 620's behaviour.
+        //
+        nv->is_pm_unsupported = gpuIsPowerManagementUnsupported(pGpu) &&
+                                !RmIsN1xLaptopGpu(nv);
 
         // UNLOCK: release GPUs lock
         rmGpuLocksRelease(GPUS_LOCK_FLAGS_NONE, NULL);
-- 
2.43.0

