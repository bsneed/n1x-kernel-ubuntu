# SPDX-License-Identifier: GPL-2.0-only
# n1x-kernel-ubuntu config fragment, merged onto Ubuntu's linux-nvidia 7.0.0-1026.27 config
# (/boot/config-7.0.0-1026-nvidia; pinned in ../sources) before `make olddefconfig`.
# scripts/config-check.sh fails the build if any line here does not survive olddefconfig.
#
# Ubuntu's config is NVIDIA's own N1x kernel config, so the platform drivers are already in it.
# Compared with Omarchy's config.aarch64 run through olddefconfig on the same patched tree, the
# N1x-relevant differences are only the options below. Everything else stays Ubuntu's choice
# (AppArmor, LSM order, performance governor, no hibernation, debug info + BTF, Rust), so
# Ubuntu's userspace sees the kernel it expects. The Snapdragon, Surface and Dell options
# Omarchy turns on are left at Ubuntu's (off): no N1x machine uses them.

# --- Ubuntu signing keys ------------------------------------------------------------------
# Ubuntu's config names its build tree's certificate files (debian/canonical-*.pem), which
# a kernel.org tree has not. Modules are signed with a key generated at build time instead.
CONFIG_SYSTEM_TRUSTED_KEYS=""
CONFIG_SYSTEM_REVOCATION_KEYS=""

# --- USB4 / Thunderbolt (Omarchy 1073-1089, 1105, 1112) -----------------------------------
# The N1x host routers are ACPI platform devices (NVDA8100); thunderbolt_platform drives them.
# New in Omarchy's patches, so Ubuntu's config has no value for it. Omarchy builds it as m.
CONFIG_USB4=m
CONFIG_USB4_PLATFORM_NHI=m
# PCIe tunnels need native PCIe hotplug on the tunnel root ports.
CONFIG_HOTPLUG_PCI_PCIE=y
# 1088 gives external-facing ports a translated IOMMU domain; the rest stay passthrough, as in
# both Ubuntu's and Omarchy's configs.
CONFIG_IOMMU_DEFAULT_PASSTHROUGH=y

# --- N1x platform (must hold; same in Ubuntu's and Omarchy's configs) ----------------------
# MT8901 pin control and the SSPM/power_wrap the USB4, I2C (keyboard, touchpad) and xHCI
# controllers are powered through; the FF-A embedded controller (battery, AC, lid, UCSI).
CONFIG_PINCTRL_MT8901=y
CONFIG_MTK_SSPM_CI=y
CONFIG_MTK_POWER_WRAP=y
CONFIG_USB_XHCI_MTK_V2=m
CONFIG_NVIDIA_FFA_EC=y
# NVIDIA's driver mis-maps memory on 64K pages (open-gpu-kernel-modules #1269).
CONFIG_ARM64_4K_PAGES=y
# Omarchy keeps kexec handover off by default (7.2.5-15).
# CONFIG_KEXEC_HANDOVER_ENABLE_DEFAULT is not set

# --- Firmware safety (Omarchy 7.3-24) ------------------------------------------------------
# Keep kernel crash logs out of UEFI variables: a full variable store can leave a laptop's
# firmware unable to boot. efi_pstore can still be turned on with efi_pstore.pstore_disable=0.
CONFIG_EFI_VARS_PSTORE_DEFAULT_DISABLE=y
